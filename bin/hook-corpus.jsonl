# Everyday commands and known writes for bin/hook-diff: ["agent_type or empty", "command"] per line.
# Rows are data for the hook to judge. Never run one: some push, delete or install.
# Add the rows a review tried. The verdicts live in the hook's own test; this file only shows what an edit changed.
# --- main agent ---
["","ls -la"]
["","git status --short"]
["","git log --oneline -5"]
["","git diff HEAD -- src"]
["","git show --stat HEAD"]
["","git commit -q -m \"fix: a > b, it's done\""]
["","git commit -q -m \"$(cat <<'EOF'\nfix: say \"x\" > y\n\nCo-Authored-By: A <a@b.c>\nEOF\n)\""]
["","gh pr create --title 'a' --body \"$(cat <<'EOF'\nbody > x\nEOF\n)\""]
["","git push"]
["","git -C repo fetch --all && git -C repo status"]
["","make check > /tmp/check.log 2>&1"]
["","make check 2>&1 | sed -n '1,40p'"]
["","npm test -- --run 2>&1"]
["","pytest -q tests/test_x.py::test_y"]
["","python3 -I bin/test_check.py"]
["","python3 -c 'print(1)'"]
