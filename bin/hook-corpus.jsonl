["","docker run --rm img make test"]
["","docker compose logs --tail 50 api"]
["","ssh host 'ls -la /var/log'"]
["","jq '.a | .b' f.json"]
["","jq -r '.items[] | select(.n > 3) | .name' f.json"]
["","awk '{print $1}' f | sort | uniq -c"]
["","awk -F: '$3 > 100 {print $1}' /etc/passwd"]
["","sed -n '1,40p' file.txt"]
["","sed -n '/a>b/p' f"]
["","grep -rn 'a > b' src"]
["","find . -name '*.py' -newer x"]
["","for f in a b; do echo $f; done"]
["","for f in a b; do make $f; done > /tmp/build.log 2>&1"]
["","while read l; do echo \"$l\"; done < in.txt"]
["","if [ -f x ]; then cat x; fi"]
["","case $x in a) make;; b) make test;; esac"]
["","(cd sub && make check > /tmp/sub.log 2>&1)"]
["","{ make a; make b; } > /tmp/ab.log 2>&1"]
["","echo start; { make check; } > /tmp/log 2>&1"]
["","{ npm test; echo \"exit $?\"; } > /tmp/log 2>&1"]
["","echo done"]
["","echo \"$(date)\""]
["","echo \"cost: $5 > $3\""]
["","X=1 Y=2 make"]
["","cd \"$(git rev-parse --show-toplevel)\" && make > /tmp/log 2>&1"]
["","kill $(cat pid)"]
["","[ \"$(id -u)\" = 0 ] && echo root"]
["","[[ $a > $b ]] && echo bigger"]
["","sleep 5 & wait"]
["","cat <<< \"x\""]
["","cat file.txt"]
["","wc -l README.md"]
["","test -d x || mkdir x"]
["","cp a b"]
["","mv a b"]
["","rm -f tmp.txt"]
["","curl -s https://example.com | jq ."]
["","tar -xzf a.tgz"]
["","git commit -q -F - <<'EOF'\nfix: x > y\nEOF"]
["","bash run.sh"]
["","bash -c 'cd x && make check'"]
["","sudo make install"]
["","time make"]
["","xargs -n 1 echo < list"]
["","# a comment with don't\nls"]
["","echo x > f"]
["","printf '%s\\n' a > f.txt"]
["","cat > notes.md <<'EOF'\nhello\nEOF"]
["","sed -i '' 's/a/b/' file.txt"]
["","ls | tee out.txt"]
["","python3 - <<'EOF'\nprint(1)\nEOF"]
["","'cat' > f"]
["","(echo x > f)"]
["","{ echo x; } > f"]
["","bash -c \"echo x > f\""]
["","true & echo x > f"]
["","for i in 1 2; do echo $i; done > f"]
