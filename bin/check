#!/usr/bin/env python3
"""Gate for this repo: bin/check [--repo-only] [repo]. Runs every self-test and the static checks below; exit 1 on any problem.
--repo-only (CI): skips what only the owner's machine can answer, the Names check and ~/.claude pointers the repo does not ship.
Layout: claude/common/ is shared; claude/unix/ (macOS, Linux) and claude/windows/ each overlay it onto ~/.claude.
- JSON: every settings.example.json (claude/unix, claude/windows, pi) parses.
- Settings: every ~/.claude/... path a setting calls exists in its OS dir or common/; unix hooks are executable.
- Pointers: every `~/.claude/<file>` in common/ and unix/ *.md exists there or in ~/.claude; every bare `<name>.md` exists there.
- Names: every Route lead-skill name, and every `plugin:skill` of an installed plugin, is an installed skill, an agent or built in;
  a plugin the settings declare but this machine lacks is skipped.
- Exec: a claude/windows/ hook or a Python hook in claude/common/hooks/ never starts a bare program name (Windows searches
  the cwd, the user's project, first).
  Reads list/tuple argv, also as the left side of +; os.system, shell=True strings and argv held in a variable are not read.
- Docs: every hook a settings.example.json calls is named in that OS's README (README.md, claude/windows/README.md).
- Drops: ALLOWED_DROPS in hooks/agent-no-downgrade equals the "<tier> /" entries of agent-tuning.md's "Drop when" column.
- pi (warnings only): ~/.pi/agent/settings.json exists but its packages do not include this repo's pi/, or its
  subagents.agentOverrides differ from pi/settings.example.json.
- Twins (warning only): claude/common/CLAUDE.md or pi/AGENTS.md is staged without the other.
The last line counts the self-tests and those that printed a line starting with "skip".
- Skills: CLAUDE.md and rules/ tell the model to call no skill that has disable-model-invocation: true,
  unless skill-model-invocable unlocks it; a user-only skill is written `/name`.
Self-test: python3 -I bin/test_check.py"""
import ast, glob, json, ntpath, os, re, subprocess, sys

REPO_ONLY = "--repo-only" in sys.argv
ARGS = [a for a in sys.argv[1:] if not a.startswith("--")]
REPO = os.path.abspath(ARGS[0] if ARGS else os.path.join(os.path.dirname(__file__), ".."))
CLAUDE = os.path.join(REPO, "claude", "common")
UNIX = os.path.join(REPO, "claude", "unix")
WINDOWS = os.path.join(REPO, "claude", "windows")
UNIX_SETTINGS, WINDOWS_SETTINGS = "claude/unix/settings.example.json", "claude/windows/settings.example.json"
HOME_DOT = os.path.expanduser("~/.claude")
PROJECT_FILES = {"CLAUDE.md", "AGENTS.md", "SKILL.md", "README.md", "GLOSSARY.md", "architecture.md"}  # live in other repos
problems = []


def rel(p):
    return os.path.relpath(p, REPO)


# Self-tests
tests = sorted(glob.glob(os.path.join(CLAUDE, "hooks", "test_*.py")) + glob.glob(os.path.join(REPO, "bin", "test_*.py"))
               + glob.glob(os.path.join(CLAUDE, "skills", "*", "scripts", "test_*.py"))
               + glob.glob(os.path.join(UNIX, "hooks", "test_*.py"))
               + glob.glob(os.path.join(WINDOWS, "hooks", "test_*.py"))
               + glob.glob(os.path.join(REPO, "pi", "test_*.py")))
skipped = 0  # self-tests that left part of their work out and said so
for t in tests:
    p = subprocess.run([sys.executable, "-I", t], capture_output=True, text=True)
    skipped += bool(re.search(r"(?mi)^skip", p.stdout))
    if p.returncode:
        problems.append("%s failed:\n%s" % (rel(t), (p.stdout + p.stderr)[-800:]))

# JSON
settings = {}  # file -> parsed settings
for f in [UNIX_SETTINGS, WINDOWS_SETTINGS, "pi/settings.example.json"]:
    path = os.path.join(REPO, f)
    if not os.path.exists(path):
        if f == UNIX_SETTINGS:
            problems.append("%s is missing" % f)
        continue
    try:
        with open(path, encoding="utf-8") as fh:
            settings[f] = json.load(fh)
    except ValueError as e:
        problems.append("%s does not parse: %s" % (f, e))


# Settings: paths the config calls
def strings(x):
    if isinstance(x, dict):
        for v in x.values():
            yield from strings(v)
    elif isinstance(x, list):
        for v in x:
            yield from strings(v)
    elif isinstance(x, str):
        yield x


unlocked = set()
for f, data in settings.items():
    if f.startswith("pi/"):  # pi settings call no ~/.claude path
        continue
    homes = ["claude/unix" if f == UNIX_SETTINGS else "claude/windows", "claude/common"]  # each OS overlay falls back to common/
    for s in strings(data):
        words = s.split()
        for i, w in enumerate(words):
            m = re.match(r"(?:~|C:/Users/YOU)/\.claude/(\S+)$", w)
            if not m:
                continue
            target = next((os.path.join(REPO, h, m.group(1)) for h in homes if os.path.exists(os.path.join(REPO, h, m.group(1)))), None)
            if target is None:
                problems.append("%s calls %s, which %s lacks" % (f, w, " or ".join(h + "/" for h in homes)))
            elif f == UNIX_SETTINGS and m.group(1).startswith("hooks/") and not os.access(target, os.X_OK):
                problems.append("%s is not executable" % rel(target))
            if f == UNIX_SETTINGS and w.endswith("/skill-model-invocable"):
                unlocked.update(words[i + 1:])

# Pointers
names_in_repo = {os.path.basename(p) for d in (CLAUDE, UNIX) for p in glob.glob(os.path.join(d, "**", "*"), recursive=True)}
for md in [p for d in (CLAUDE, UNIX) for p in glob.glob(os.path.join(d, "**", "*.md"), recursive=True)]:
    with open(md, encoding="utf-8") as fh:
        text = fh.read()
    for path in set(re.findall(r"~/\.claude/([\w./-]+\.\w+)", text)):
        if not REPO_ONLY and not any(os.path.exists(os.path.join(d, path)) for d in (CLAUDE, UNIX, HOME_DOT)):
            problems.append("%s points to ~/.claude/%s, which does not exist" % (rel(md), path))
    for name in set(re.findall(r"`([\w.-]+\.md)`", text)):
        if name not in names_in_repo and name not in PROJECT_FILES:
            problems.append("%s points to %s, which claude/common/ and claude/unix/ lack" % (rel(md), name))

# Skills the model is told to call
FRONT = re.compile(r"---\r?\n.*?\r?\n---\r?\n", re.S)  # same frontmatter rule as hooks/skill-model-invocable
FLAG = re.compile(r"^disable-model-invocation:[ \t]*true[ \t]*\r?$", re.M)
BUILTIN = {"security-review", "update-config", "artifact-design", "dataviz", "claude-api", "claude-code-guide"}  # ship inside Claude Code or the desktop app


def installed_plugins():
    """plugin name -> install folder, from Claude Code's install record (older cached versions do not count)."""
    try:
        with open(os.path.join(HOME_DOT, "plugins", "installed_plugins.json"), encoding="utf-8") as fh:
            record = json.load(fh).get("plugins", {})
    except (OSError, ValueError):
        return {}
    return {key.split("@")[0]: entries[-1]["installPath"] for key, entries in record.items() if entries}


PLUGINS = installed_plugins()


def find_skill(name):
    """SKILL.md for `name` or `plugin:name`: user skills, this repo's skills, then installed plugins."""
    plugin, _, skill = name.rpartition(":")
    paths = [] if plugin else [os.path.join(HOME_DOT, "skills", skill, "SKILL.md"), os.path.join(CLAUDE, "skills", skill, "SKILL.md")]
    roots = [PLUGINS[plugin]] if plugin in PLUGINS else [] if plugin else list(PLUGINS.values())
    paths += [os.path.join(root, "skills", skill, "SKILL.md") for root in roots]
    if plugin in ("", skill) and skill in PLUGINS:  # a plugin that is itself one skill keeps SKILL.md at its root
        paths.append(os.path.join(PLUGINS[skill], "SKILL.md"))
    return next((p for p in paths if os.path.isfile(p)), None)


def is_plugin(prefix):
    return prefix in PLUGINS


def is_agent(name):
    plugin, _, agent = name.rpartition(":")
    dirs = [PLUGINS[plugin]] if plugin in PLUGINS else [] if plugin else [CLAUDE, HOME_DOT]
    return any(os.path.isfile(os.path.join(d, "agents", agent + ".md")) for d in dirs)


def owner(path):
    """The installed plugin a SKILL.md belongs to, or None."""
    return next((p for p, root in PLUGINS.items() if path.startswith(os.path.join(root, ""))), None)


# plugins the settings enable or disable: on a machine that lacks one, its names are skipped, not failed
DECLARED = {key.split("@")[0] for data in settings.values() for key in data.get("enabledPlugins", {})}


for md in [os.path.join(CLAUDE, "CLAUDE.md")] + glob.glob(os.path.join(CLAUDE, "rules", "*.md")):
    if not os.path.exists(md):
        continue
    with open(md, encoding="utf-8") as fh:
        text = fh.read()
    lead = set()  # names in the Route table's lead-skill column must resolve; elsewhere only names under an installed plugin
    if md.endswith("CLAUDE.md"):
        for line in text.splitlines():
            if line.startswith("|") and line.count("|") >= 5:
                lead.update(re.findall(r"`([\w:.-]+)`", line.split("|")[3]))
    for name in sorted(set(re.findall(r"`([\w:.-]+)`", text))):
        skill = find_skill(name)
        if skill is None:
            prefix = name.rpartition(":")[0] or name
            if prefix in DECLARED and prefix not in PLUGINS:
                continue
            if not REPO_ONLY and (name in lead or is_plugin(name.rpartition(":")[0])) and name not in BUILTIN and not is_agent(name):
                problems.append("%s names `%s`, which no installed skill or agent matches" % (rel(md), name))
            continue
        if name in unlocked:
            continue
        with open(skill, encoding="utf-8", errors="replace") as fh:
            front = FRONT.match(fh.read())
            if front and FLAG.search(front.group(0)):
                full = name if ":" in name or not owner(skill) else "%s:%s" % (owner(skill), name)
                problems.append("%s tells the model to call `%s`, which is user-only: write `/%s`, or unlock it with skill-model-invocable"
                                % (rel(md), name, full))

# Docs: a hook the settings call but the README never names is a hook nobody was told about (skipped where the README is absent)
for f, readme in ((UNIX_SETTINGS, "README.md"), (WINDOWS_SETTINGS, "claude/windows/README.md")):
    if f not in settings or not os.path.exists(os.path.join(REPO, readme)):
        continue
    with open(os.path.join(REPO, readme), encoding="utf-8") as fh:
        text = fh.read()
    for name in sorted({m for s in strings(settings[f]) for m in re.findall(r"/\.claude/hooks/([\w.-]+)", s)}):
        if name not in text:
            problems.append("%s calls hooks/%s, which %s does not name" % (f, name, readme))

# Drops: the hook and the table it enforces say the same (skipped where either is absent)
drops_hook, tuning = os.path.join(CLAUDE, "hooks", "agent-no-downgrade"), os.path.join(CLAUDE, "agent-tuning.md")
if os.path.exists(drops_hook) and os.path.exists(tuning):
    with open(drops_hook, encoding="utf-8") as fh:
        try:
            allowed = next((ast.literal_eval(n.value) for n in ast.walk(ast.parse(fh.read())) if isinstance(n, ast.Assign)
                            and getattr(n.targets[0], "id", "") == "ALLOWED_DROPS"), None)
        except ValueError:  # not a literal: this check cannot read it
            allowed = None
            problems.append("%s: ALLOWED_DROPS must be a literal dict of sets, so bin/check can compare it with agent-tuning.md" % rel(drops_hook))
    listed = {}
    with open(tuning, encoding="utf-8") as fh:
        for line in fh:
            cells = [c.strip() for c in line.split("|")]
            tiers = set(re.findall(r"\b(haiku|sonnet|opus|fable) /", cells[5])) if len(cells) >= 7 else set()
            if tiers and re.match(r"`[\w-]+`$", cells[1]):
                listed[cells[1].strip("`")] = tiers
    if allowed is not None and allowed != listed:
        for agent in sorted(set(allowed) | set(listed)):
            if allowed.get(agent, set()) != listed.get(agent, set()):
                problems.append("agent-no-downgrade lets `%s` drop to %s, but agent-tuning.md \"Drop when\" lists %s" % (
                    agent, sorted(allowed.get(agent, set())) or "nothing", sorted(listed.get(agent, set())) or "nothing"))

# Exec: argv[0] of a subprocess call in a hook Windows runs is a full path or a value (resolve(), which(), sys.executable), never a literal name
for py in glob.glob(os.path.join(WINDOWS, "**", "*.py"), recursive=True) + glob.glob(os.path.join(CLAUDE, "hooks", "*")):
    if os.path.basename(py).startswith("test_") or not os.path.isfile(py):  # tests run in a temp dir, not in the user's project
        continue
    with open(py, encoding="utf-8", errors="replace") as fh:
        source = fh.read()
    if not py.endswith(".py") and "python" not in source.split("\n", 1)[0]:  # shared hooks have no suffix: the shebang says Python
        continue
    tree = ast.parse(source, py)
    for node in ast.walk(tree):
        if (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                and node.func.attr in ("run", "Popen", "call", "check_call", "check_output")
                and node.args):
            argv = node.args[0]
            while isinstance(argv, ast.BinOp):  # ["git", "-C", cwd] + list(args)
                argv = argv.left
            if not (isinstance(argv, (ast.List, ast.Tuple)) and argv.elts):
                continue
            head = argv.elts[0]
            if isinstance(head, ast.Constant) and isinstance(head.value, str) and not ntpath.isabs(head.value):  # Windows rules on every OS
                problems.append("%s:%d runs bare %r: Windows searches the cwd (the user's project) first; use resolve(), path_only.which() or a full path"
                                % (rel(py), node.lineno, head.value))

# pi: a machine that runs pi (~/.pi/agent/settings.json) without this repo's package runs none of armarium-pi's gates.
# A warning, not a problem: it is this machine's state, not the repo's.
pi_pkg, pi_settings = os.path.join(REPO, "pi"), os.path.join(os.path.expanduser("~/.pi/agent"), "settings.json")
if not REPO_ONLY and os.path.isfile(os.path.join(pi_pkg, "package.json")) and os.path.isfile(pi_settings):
    try:
        with open(pi_settings, encoding="utf-8") as fh:
            pi_live = json.load(fh)
    except (OSError, ValueError):
        pi_live = {}
    packages = pi_live.get("packages", []) if isinstance(pi_live, dict) else []
    sources = [p.get("source", "") if isinstance(p, dict) else str(p) for p in packages]
    if not any(os.path.realpath(os.path.expanduser(s)) == os.path.realpath(pi_pkg) for s in sources):
        print("WARN pi on this machine does not load %s, so no pi run has armarium-pi's gates: run `pi install %s`" % (rel(pi_pkg), pi_pkg))
    def overrides(data):
        sub = data.get("subagents") if isinstance(data, dict) else None
        return sub.get("agentOverrides") if isinstance(sub, dict) else None
    example, live = overrides(settings.get("pi/settings.example.json")), overrides(pi_live)
    if isinstance(example, dict) and isinstance(live, dict):
        home = os.path.expanduser("~").replace("\\", "/")

        def tier(v):  # the example writes this machine's home as /Users/YOU; a Windows path compares with forward slashes
            return json.dumps(v, sort_keys=True).replace("\\\\", "/").replace(home, "/Users/YOU")
        for name in sorted(set(example) | set(live)):
            if tier(example.get(name)) != tier(live.get(name)):
                print("WARN pi tier of %s differs: pi/settings.example.json has %s, %s has %s" % (
                    name, tier(example.get(name)), pi_settings, tier(live.get(name))))

# Twins: claude/common/CLAUDE.md and pi/AGENTS.md carry the same rules (CLAUDE.md of this repo). Under pre-commit, a commit
# that stages one alone gets a warning; a one-sided edit can be right, so it is not a problem.
twins = ("claude/common/CLAUDE.md", "pi/AGENTS.md")
if not REPO_ONLY and all(os.path.exists(os.path.join(REPO, t)) for t in twins):
    try:
        staged = subprocess.run(["git", "-C", REPO, "diff", "--cached", "--name-only"], capture_output=True, text=True, timeout=10).stdout.split("\n")
    except (OSError, subprocess.SubprocessError):
        staged = []
    for one, other in (twins, twins[::-1]):
        if one in staged and other not in staged:
            print("WARN %s is staged without %s: a rule change in one goes into the other in the same commit" % (one, other))

for p in problems:
    print("FAIL " + p)
print("check: ok (%d self-tests%s)" % (len(tests), ", %d with a skip" % skipped if skipped else "") if not problems
      else "check: %d problem(s)" % len(problems))
sys.exit(1 if problems else 0)
