#!/usr/bin/env python3
# Stop gate: every skill a `Flow:` line of this session names in backticks needs a `Skill` call in this session
# (CLAUDE.md Exit: "a name in the Flow: line is not a call"), unless a reply of this session lists it as ✗.
# Only names that exist under ~/.claude/skills are checked. Blocks once; stop_hook_active lets the retry through.
# Self-test: python3 -I ~/.claude/hooks/test_flow_skill_check.py
import json, os, re, sys

SKILLS = os.path.expanduser("~/.claude/skills")
CALL_IN_CODE = re.compile(r"""skill\s*:\s*['"]([\w:.-]+)['"]""")
SLASH = re.compile(r"\s*(?:<command-message>[^<]*</command-message>\s*)?<command-name>/([\w:.-]+)</command-name>")  # only at the start: notifications quote tags

try:
    data = json.load(sys.stdin)
    if data.get("stop_hook_active"):
        sys.exit(0)
    records, slashed = [], set()
    with open(data.get("transcript_path") or "", encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("type") == "assistant" and not r.get("isSidechain"):
                records.append((r.get("message") or {}).get("content") or [])
            elif r.get("type") == "user" and not r.get("isSidechain"):
                c = (r.get("message") or {}).get("content")
                if isinstance(c, str):  # a typed /skill is a plain-string user record; tool results are lists
                    m = SLASH.match(c)
                    if m:
                        slashed.add(m.group(1).split(":")[-1])
except Exception:
    sys.exit(0)

flows, called, crossed = [], set(slashed), set()
for content in records:
    if not isinstance(content, list):
        continue
    texts = [b.get("text", "") for b in content if b.get("type") == "text"]
    for t in texts:
        for ln in t.splitlines():
            if ln.lstrip().startswith("Flow:"):
                flows.append(ln)
            elif "✗" in ln:
                crossed.update(re.findall(r"`([\w.-]+)`", ln))
    for b in content:
        if b.get("type") != "tool_use":
            continue
        inp = b.get("input") or {}
        if b.get("name") == "Skill":
            called.add(str(inp.get("skill", "")).split(":")[-1])
        else:
            called.update(n.split(":")[-1] for n in CALL_IN_CODE.findall(str(inp.get("code", ""))))

named = [n for fl in flows for n in re.findall(r"`([\w.-]+)`", fl) if os.path.isfile(os.path.join(SKILLS, n, "SKILL.md"))]
missing = [n for n in dict.fromkeys(named) if n not in called and n not in crossed]
if missing:
    names = ", ".join("`%s`" % n for n in missing)
    print(json.dumps({"decision": "block", "reason":
        "The Flow line names %s, but this session has no Skill call for it. Call it now, "
        "or list it as ✗ with the reason in the Exit (CLAUDE.md Exit). A name that is only a file you edit needs nothing." % names}))
sys.exit(0)
