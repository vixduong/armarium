#!/usr/bin/env python3
# Stop gate for Code flow step 8: a turn with a Flow line whose own edits are not Small (>80 changed lines or >2 files,
# markdown and text excluded) needs a `reviewer` agent or `code-review` call after this turn's prompt, made once at
# least one of those edits existed: a review that ran before all of them (a plan review) does not count, where the
# transcript shows every edit; with edits only git sees (REPL, subagents, Bash) the order is unknown and it counts. Blocks once;
# stop_hook_active lets the retry through, so the agent runs the review instead of only listing it as ✗.
# Counts Write/Edit/MultiEdit inputs of the transcript, plus what git sees in cwd: files changed since the turn's
# prompt (REPL write()/edit(), subagents, Bash), each file counted once at its larger figure.
# shortcut: git counts a file's whole diff against HEAD and skips deletions, so earlier uncommitted edits to a file
# touched this turn count too; snapshot numstat at UserPromptSubmit if that over-blocks.
# Also step 8's security branch: a security-only reviewer prompt while `git rev-parse origin/HEAD` resolves in cwd and no
# `security-review` call → block once, so the agent runs the skill instead of asserting origin/HEAD is missing.
# A non-Small code diff whose turn names only prose rows (Agent docs, Writing, Report, ...) also needs the Code row, reviewed
# or not: a generator or script inside a docs task gets no plan or red test otherwise.
# Self-test: python3 -I ~/.claude/hooks/test_reviewer_gate.py
import json, os, re, subprocess, sys
from datetime import datetime
from path_only import which

DOCS = (".md", ".markdown", ".txt", ".rst")
CODE_ROW = re.compile(r"\bcode flow\b(?! steps)")  # "Agent docs + Code flow" names the Code row; the Plan row's "Code flow steps 1, 3, 4" does not
PROSE_ROWS = ("agent docs", "writing", "report", "research", "plan or spec", "answer directly", "question answered")  # Route rows with no Code flow
REVIEW_IN_CODE = re.compile(r"""subagent_type\s*:\s*['"]reviewer['"]|skill\s*:\s*['"](?:[\w-]+:)?code-review['"]""")
SECURITY = re.compile(r"\bsecurity[- ]only\b", re.I)  # step 8's own phrase for the reviewer that stands in for `security-review`
SEC_SKILL_IN_CODE = re.compile(r"""skill\s*:\s*['"](?:[\w-]+:)?security-review['"]""")

def lines(s): return len(str(s or "").splitlines())

def key(p): return os.path.normcase(os.path.realpath(p))  # git and transcript agree (macOS /private/var, Windows slashes)

def git_changes(cwd, since):
    """({key(path): changed lines}, complete) for non-doc files in cwd's work tree modified at or after `since` (epoch s).
    complete is False when the scan stopped early, the turn being past Small already."""
    def git(*a): return subprocess.run([which("git"), "-C", cwd, *a], capture_output=True, timeout=3).stdout.decode("utf-8", "replace")
    top = git("rev-parse", "--show-toplevel").strip()
    if not top:
        return {}, True
    numstat = {}
    for rec in git("diff", "--numstat", "-z", "HEAD").split("\0"):
        parts = rec.split("\t")
        if len(parts) == 3 and parts[0].isdigit():
            numstat[parts[2]] = int(parts[0]) + int(parts[1])
    out, recs = {}, iter(git("status", "--porcelain", "-z", "--untracked-files=all").split("\0"))
    for rec in recs:
        if rec[:1] in ("R", "C"):
            next(recs, None)  # -z puts a rename's old path in the next record
        rel = rec[3:]
        path = os.path.join(top, rel)
        if (not rel or rel.lower().endswith(DOCS) or os.path.islink(path) or not os.path.isfile(path)
                or os.path.getmtime(path) < since):
            continue
        if rel in numstat:
            out[key(path)] = numstat[rel]
        elif rec.startswith("??"):
            with open(path, "rb") as f:
                head = f.read(5_000_000)
            if b"\0" not in head[:8000]:  # binary (screenshots): not code
                out[key(path)] = head.count(b"\n")
        if len(out) > 2 or sum(out.values()) > 80:
            return out, False  # already past Small
    return out, True

try:
    data = json.loads(sys.stdin.buffer.read().decode("utf-8"))
    if data.get("stop_hook_active"):
        sys.exit(0)
    per_file, flow, reviewed, since, rows = {}, False, False, None, []
    after_edit = False  # whether a transcript edit of this turn preceded a review
    sec_reviewer = sec_skill = False  # step 8: `git rev-parse origin/HEAD` succeeds → `security-review`, not a security-only reviewer
    with open(data.get("transcript_path") or "", encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("isSidechain"):
                continue
            content = (r.get("message") or {}).get("content")
            if r.get("type") == "user":
                typed = isinstance(content, str) or (isinstance(content, list) and not any(
                    isinstance(b, dict) and b.get("type") == "tool_result" for b in content))  # list: text + image
                if typed and not r.get("isMeta") and (r.get("origin") or {}).get("kind", "human") == "human":
                    per_file, flow, reviewed, rows = {}, False, False, []  # a new prompt starts a new turn
                    after_edit = False
                    sec_reviewer = sec_skill = False
                    try:
                        since = datetime.fromisoformat(r["timestamp"].replace("Z", "+00:00")).timestamp()
                    except (KeyError, ValueError, AttributeError):
                        since = None
                continue
            if r.get("type") != "assistant" or not isinstance(content, list):
                continue
            for b in content:
                if b.get("type") == "text":
                    for ln in b.get("text", "").splitlines():
                        if ln.lstrip().startswith("Flow:"):
                            flow = True
                            rows.append(ln.split("Flow:", 1)[1].strip().lower())
                if b.get("type") != "tool_use":
                    continue
                name, inp = b.get("name"), b.get("input") or {}
                path = str(inp.get("file_path", ""))
                if name in ("Write", "Edit", "MultiEdit") and not path.lower().endswith(DOCS):
                    n = lines(inp.get("content")) if name == "Write" else sum(
                        lines(e.get("old_string")) + lines(e.get("new_string")) for e in (inp.get("edits") or [inp]))
                    path = key(path) if path else path
                    per_file[path] = per_file.get(path, 0) + n
                elif name in ("Agent", "Task") and inp.get("subagent_type") == "reviewer":
                    reviewed = True
                    sec_reviewer = sec_reviewer or bool(SECURITY.search(str(inp.get("prompt", ""))))
                elif name == "Skill" and str(inp.get("skill", "")).split(":")[-1] == "code-review":
                    reviewed = True
                elif name == "Skill" and str(inp.get("skill", "")).split(":")[-1] == "security-review":
                    sec_skill = True
                else:
                    code = str(inp.get("code", ""))
                    if REVIEW_IN_CODE.search(code):
                        reviewed = True
                        sec_reviewer = sec_reviewer or bool(SECURITY.search(code))
                    sec_skill = sec_skill or bool(SEC_SKILL_IN_CODE.search(code))
                if ((name in ("Agent", "Task") and inp.get("subagent_type") == "reviewer")
                        or (name == "Skill" and str(inp.get("skill", "")).split(":")[-1] == "code-review")
                        or (name not in ("Write", "Edit", "MultiEdit", "Agent", "Task", "Skill") and REVIEW_IN_CODE.search(str(inp.get("code", ""))))):
                    after_edit = after_edit or bool(per_file)  # this block is a review: had an edit come before it?
    in_transcript, all_seen = set(per_file), True  # all_seen: every edit of the turn is a Write/Edit the transcript shows
    if flow and since is not None and data.get("cwd"):
        try:
            changes, complete = git_changes(data["cwd"], since - 1)
            all_seen = complete and all(path in in_transcript for path in changes)
            for path, n in changes.items():
                per_file[path] = max(per_file.get(path, 0), n)
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    if reviewed and not after_edit and in_transcript and all_seen:
        reviewed = False  # the review ran before every edit there is: it reviewed a plan, not this diff
    origin_head = False
    if sec_reviewer and not sec_skill and data.get("cwd"):
        try:
            origin_head = subprocess.run([which("git"), "-C", data["cwd"], "rev-parse", "--verify", "--quiet", "origin/HEAD"],
                                         capture_output=True, timeout=3).returncode == 0
        except (OSError, subprocess.SubprocessError):
            pass
except Exception as e:  # a Stop hook never fails the turn; the stderr line tells a skipped check from a pass
    sys.stderr.write("reviewer-gate: not checked (%s)\n" % type(e).__name__)
    sys.exit(0)

reasons = []
changed = sum(per_file.values())
if flow and not reviewed and (changed > 80 or len(per_file) > 2):
    reasons.append("This turn changed %d lines in %d files, which is not Small (Code flow step 8), but no `reviewer` ran on those edits. "
        "Run the `reviewer` agent on the diff now and fix its P0/P1; animation in the diff → also `review-animations`. "
        "A ✗ in the Exit does not replace the review." % (changed, len(per_file)))
if flow and rows and all(r.startswith(PROSE_ROWS) and not CODE_ROW.search(r) for r in rows) and (changed > 80 or len(per_file) > 2):
    reasons.append("Its Flow lines name only prose rows, but %d lines in %d files are code: add the Code row for them "
        "(Route: several deliverables → one row each), with a plan file when Big, each behavior's test red before its code, "
        "and that row's Done-when in the Exit." % (changed, len(per_file)))
if origin_head:
    reasons.append("A security-only `reviewer` ran, but `git rev-parse origin/HEAD` resolves here, so Code flow step 8 picks "
        "`security-review`. Call it now, or list it ✗ in the Exit with the error it gave.")
if reasons:
    print(json.dumps({"decision": "block", "reason": " ".join(reasons)}))
sys.exit(0)
