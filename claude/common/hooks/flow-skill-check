#!/usr/bin/env python3
# Stop gate: every skill a `Flow:` line names in backticks needs, after the last Flow line that names it,
# a `Skill` call or a reply listing it as ✗ (CLAUDE.md Exit). A `/skill` command the user typed to start
# that task counts as the call. Only names that exist under ~/.claude/skills are checked, minus user-only skills
# (disable-model-invocation: true), which the model cannot call. A `Flow: answer directly` line needs no Exit.
# Only Flow lines after the last user message are checked. Blocks once; stop_hook_active lets the retry through.
# A turn with a Flow line must also end on a reply holding a ✓ or ✗ line: the Exit's Done-when list. A ✓ item (its line
# and indented sub-bullets) that names an exception blocks: CLAUDE.md Exit makes it ✗. A turn whose cwd repo changed
# files the frontend gate's `paths:` cover (commits since the prompt, or dirty files touched since) needs `UI` on its Flow line.
# Self-test: python3 -I ~/.claude/hooks/test_flow_skill_check.py
import json, os, re, subprocess, sys
from path_only import which

SKILLS = os.path.expanduser("~/.claude/skills")
CALL_IN_CODE = re.compile(r"""skill\s*:\s*['"]([\w:.-]+)['"]""")
SLASH = re.compile(r"\s*(?:<command-message>[^<]*</command-message>\s*)?<command-name>/([\w:.-]+)</command-name>")  # only at the start: notifications quote tags
NAME = re.compile(r"`([\w.-]+)`")
EXCEPTION = re.compile(r"(?<!\w)(?:except|but|unless|apart from|(?<!loại )trừ|nhưng)(?!\w)", re.I)  # not "only": the Git row's Done-when says it
ITEM = re.compile(r"\s*(?:(?:[-*]|\d+\.)\s*)?(?:\*\*\s*)?([✓✗])")  # an Exit item starts with its mark; prose may quote one
EXCLUSIONS = re.compile(r"exclu|loại trừ", re.I)  # the Report row's "exclusions stated" item lists what it excludes
USER_ONLY = re.compile(r"^disable-model-invocation:\s*true\s*$", re.M)

def checked(n):
    """A skill the model can call: its SKILL.md exists and its frontmatter does not reserve it for the user."""
    path = os.path.join(SKILLS, n, "SKILL.md")
    if n.startswith(".") or not os.path.isfile(path):
        return False
    with open(path, encoding="utf-8", errors="replace") as f:
        head = f.read(4000).replace("\r\n", "\n").split("\n---", 1)[0]  # frontmatter only
    return not USER_ONLY.search(head)

FRONTEND = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "rules", "frontend.md")  # repo and ~/.claude alike

def excepted(reply):
    """The ✓ items of an Exit list that name an exception, on their line or in an indented sub-bullet."""
    item, bad = None, []
    for ln in reply.splitlines():
        ln = re.sub(r"`[^`]*`", "", ln)  # code spans hold keywords, not exceptions
        mark = ITEM.match(ln)
        if mark:
            item = ln.strip() if mark.group(1) == "✓" and not EXCLUSIONS.search(ln) else None
            if item and EXCEPTION.search(ln):
                bad.append(item)
        elif item and ln[:1].isspace() and ln.lstrip().startswith(("-", "*")):
            if EXCEPTION.search(ln) and item not in bad:
                bad.append(item)
        else:
            item = None
    return bad

def ui_changes(cwd, since):
    """Files under cwd's repo with a frontend-gate extension, committed or touched (dirty) since `since` (epoch s)."""
    with open(FRONTEND, encoding="utf-8") as f:
        m = re.search(r"\{([\w,]+)\}", f.read().split("---")[1])  # paths: "**/*.{tsx,jsx,...}"
    exts = tuple("." + e for e in m.group(1).split(",")) if m else ()
    def git(*a): return subprocess.run([which("git"), "-C", cwd, *a], capture_output=True, timeout=3).stdout.decode("utf-8", "replace")
    top = git("rev-parse", "--show-toplevel").strip()
    if not exts or not top:
        return []
    names = set(git("-c", "core.quotePath=false", "log", "--since=@%d" % int(since), "--name-only", "--format=").splitlines())
    recs = iter(git("status", "--porcelain", "-z", "--untracked-files=all").split("\0"))
    for rec in recs:
        if rec[:1] in ("R", "C"):
            next(recs, None)  # -z puts a rename's old path in the next record
        path = os.path.join(top, rec[3:])
        if rec[3:] and os.path.isfile(path) and os.path.getmtime(path) >= since:
            names.add(rec[3:])
    return sorted(n for n in names if n.lower().endswith(exts))

try:
    data = json.loads(sys.stdin.buffer.read().decode("utf-8"))  # Claude Code sends UTF-8; Windows would decode stdin as cp1252
    if data.get("stop_hook_active"):
        sys.exit(0)
    events = []  # (kind, value) in transcript order: text, call, slash, prompt
    with open(data.get("transcript_path") or "", encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("isSidechain"):
                continue
            content = (r.get("message") or {}).get("content")
            if r.get("type") == "assistant" and isinstance(content, list):
                for b in content:
                    if b.get("type") == "text":
                        events.append(("text", b.get("text", "")))
                    elif b.get("type") == "tool_use":
                        inp = b.get("input") or {}
                        if b.get("name") == "Skill":
                            events.append(("call", str(inp.get("skill", "")).split(":")[-1]))
                        else:
                            events.extend(("call", n.split(":")[-1]) for n in CALL_IN_CODE.findall(str(inp.get("code", ""))))
            elif r.get("type") == "user" and (isinstance(content, str) or (isinstance(content, list) and not any(
                    isinstance(b, dict) and b.get("type") == "tool_result" for b in content))):  # a prompt: text, or text + image; tool results are lists
                if not r.get("isMeta") and (r.get("origin") or {}).get("kind", "human") == "human":  # not hook feedback, not a task notification
                    events.append(("prompt", r.get("timestamp")))  # the turn's start, for the UI-file check
                m = SLASH.match(content) if isinstance(content, str) else None
                if m:
                    events.append(("slash", m.group(1).split(":")[-1]))
    last = data.get("last_assistant_message")  # the final reply may not be in the transcript yet
    if isinstance(last, str) and last and ("text", last) not in events:  # count it once if the transcript already has it
        events.append(("text", last))
except Exception as e:  # a Stop hook never fails the turn; the stderr line tells a skipped check from a pass
    sys.stderr.write("flow-skill-check: not checked (%s)\n" % type(e).__name__)
    sys.exit(0)

# only this turn's task is checked: Flow lines after the last user message (earlier tasks were judged at their own stop)
turn = max([i for i, (kind, _) in enumerate(events) if kind == "prompt"], default=-1)
flows, last_flow = [], {}  # event index of every Flow line; name -> index of the last Flow line naming it
for i, (kind, value) in enumerate(events):
    if kind != "text":
        continue
    for ln in value.splitlines():
        if ln.lstrip().startswith("Flow:") and not ln.split("Flow:", 1)[1].strip().lower().startswith("answer directly"):  # the chat row needs no Exit
            flows.append(i)
            for n in NAME.findall(ln):
                if i > turn and checked(n):
                    last_flow[n] = i

def satisfied(n, at):
    before = max([i for i in flows if i < at], default=-1)  # the task starts after the previous Flow line
    for i, (kind, value) in enumerate(events):
        if kind == "call" and value == n and i > at:
            return True
        if kind == "slash" and value == n and before < i < at:
            return True
        if kind == "text" and i >= at and any("✗" in ln and n in NAME.findall(ln) for ln in value.splitlines() if not ln.lstrip().startswith("Flow:")):
            return True
    return False

missing = [n for n, at in last_flow.items() if not satisfied(n, at)]
reasons = []
if missing:
    names = ", ".join("`%s`" % n for n in missing)
    reasons.append("The Flow line names %s, but no Skill call for it follows that line. Call it now, "
        "or list it as ✗ with the reason in the Exit (CLAUDE.md Exit). A name that is only a file you edit needs nothing." % names)
final = next((value for kind, value in reversed(events) if kind == "text"), "")
if isinstance(last, str) and last:
    final = last
if any(i > turn for i in flows) and not any(("✓" in ln or "✗" in ln) for ln in final.splitlines() if not ln.lstrip().startswith("Flow:")):
    reasons.append("This turn has a Flow line, but the final reply has no Exit: list the row's Done-when items, "
        "each ✓ with its evidence or ✗ with the reason (CLAUDE.md Exit).")
if any(i > turn for i in flows):
    bad = excepted(final)
    if bad:
        reasons.append("A ✓ item names an exception (%s); per CLAUDE.md Exit an item with any exception is ✗, "
            "the exception its reason." % "; ".join('"%s"' % b[:80] for b in bad))
    turn_flows = [ln for i in flows if i > turn for ln in events[i][1].splitlines() if ln.lstrip().startswith("Flow:")]
    ui_flow = any(re.search(r"\bUI\b", ln) or re.match(r"\s*Flow:\s*`?Git\b", ln) for ln in turn_flows)  # a Git op commits UI files without building them
    since = events[turn][1] if turn >= 0 else None
    if not ui_flow and since and data.get("cwd"):
        try:
            from datetime import datetime
            ui = ui_changes(data["cwd"], datetime.fromisoformat(since.replace("Z", "+00:00")).timestamp() - 1)
        except Exception:  # a Stop hook never fails the turn: odd front matter or timestamp → skip the check
            ui = []
        if ui:
            reasons.append("This turn changed UI files (%s) but its Flow line has no UI row: add the UI row and its Done-when "
                "(frontend gate step 4: every width and state, shot and viewed)." % ", ".join(ui[:5]))
if reasons:
    print(json.dumps({"decision": "block", "reason": " ".join(reasons)}))
sys.exit(0)
