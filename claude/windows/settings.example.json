{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "BASH_MAX_OUTPUT_LENGTH": "10000",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "PONYTAIL_DEFAULT_MODE": "lite",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)"
    ],
    "defaultMode": "auto"
  },
  "model": "haiku",
  "availableModels": [
    "claude-opus-5-5",
    "claude-sonnet-5-5",
    "claude-fable-5-2",
    "claude-haiku-5-5"
  ],
  "skillOverrides": {
    "caveman-review": "off",
    "codebase-design": "off",
    "security-audit": "off",
    "verify-and-stop": "off",
    "ask-matt": "off",
    "grill-with-docs": "off",
    "improve-codebase-architecture": "off",
    "teach": "off",
    "to-questionnaire": "off",
    "wait-what": "off",
    "triage": "off",
    "setup-matt-pocock-skills": "off",
    "codebase-memory": "off",
    "implement-spec": "off",
    "remotion-best-practices": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/agent-no-downgrade"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/bash-ban-raw-tools.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/bash-ban-shell-writes"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/run_cli_hook.py",
              "rtk",
              "hook",
              "claude"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/write-fold-guard"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/flow-skill-check"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/reviewer-gate"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/armarium-links"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/memory_repo_symlink.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/skill-model-invocable",
              "review-animations"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/cbm_session_reminder.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:/Users/YOU/AppData/Roaming/uv/data/python/cpython-3.13-windows-x86_64-none/python.exe",
            "args": [
              "C:/Users/YOU/.claude/hooks/codemode_ponytail_band.py"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "python C:/Users/YOU/.claude/statusline.py"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "context7@claude-plugins-official": false,
    "humanizer@humanizer": true,
    "context-mode@context-mode": true,
    "hyperframes@hyperframes": false,
    "lemo-opuscar@lemolab": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": false
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      },
      "autoUpdate": false
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      },
      "autoUpdate": false
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      },
      "autoUpdate": false
    },
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar"
      },
      "autoUpdate": false
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "claude-opus-5-5",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
