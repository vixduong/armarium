#!/usr/bin/env bash
# SessionStart context adapter installed by codebase-memory-mcp.
# Fail-open: it never blocks or logs hook/prompt content.
# Local patch 2026-11-13: cache the output per cwd. `hook-augment` costs ~300 ms per session start;
# the cache stays valid until an index file (*.db) changes. `codebase-memory-mcp install --force` overwrites this file.
# Only graph context (additionalContext) is cached: a notice such as "no CBM daemon" describes one moment, and a cached
# copy replayed it to every later session after the daemon was up (2026-11-23).
# Self-test: python3 -I ~/.claude/hooks/test_cbm_session_reminder.py
BIN="$HOME/.local/bin/codebase-memory-mcp"
[ -x "$BIN" ] || exit 0
INPUT=$(cat)
D="$HOME/.cache/codebase-memory-mcp"
C="$D/hook-cache"
cwd=$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
f="$C/$(printf '%s' "$cwd" | shasum | cut -c1-16).json"
newest=$(ls -t "$D"/*.db 2>/dev/null | grep -v '/activity\.db$' | head -1)
if [ -n "$cwd" ] && [ -s "$f" ] && [[ $(<"$f") == *additionalContext* ]] && [ "$f" -nt "$D" ] && { [ -z "$newest" ] || [ "$f" -nt "$newest" ]; }; then
  cat "$f"
  exit 0
fi
# A hung binary must not hold the session start (macOS ships no `timeout`): perl runs it in its own process group
# and kills the group after 7 s, as the Windows port does, so a child that keeps the pipe open goes too.
# Without perl the binary runs unbounded, as before.
limit=${CBM_HOOK_TIMEOUT:-7}
case "$limit" in ''|*[!0-9]*|0) limit=7 ;; esac  # alarm 0 would mean no limit
if command -v perl >/dev/null 2>&1; then
  out=$(printf '%s' "$INPUT" | perl -e 'my $t = shift; my $p = fork; if (!$p) { setpgrp(0, 0); exec @ARGV; exit 127 }
    $SIG{ALRM} = sub { kill "KILL", -$p; exit 0 }; alarm $t; waitpid $p, 0' "$limit" "$BIN" hook-augment 2>/dev/null)
else
  out=$(printf '%s' "$INPUT" | "$BIN" hook-augment 2>/dev/null)
fi
printf '%s' "$out"
if [ -n "$cwd" ] && [[ $out == *additionalContext* ]]; then mkdir -p "$C" && printf '%s' "$out" > "$f.$$" && mv -f "$f.$$" "$f"; fi 2>/dev/null  # rename: a parallel session never reads half a file
exit 0
